# macOS
.DS_Store

# Raw/working files kept at the project root (not part of the published site —
# the site only references the processed copies under assets/)
/*.jpg
/*.jpeg
/*.JPG
/*.JPEG
/*.png
/*.PNG
/*.pdf
/*.PDF
/*.svg
/*.mp4
/*.mov

# Large source video is too big for git (GitHub blocks files over 100MB).
# See README / project notes for how this is hosted instead.
# home-hero.mp4 is small enough to track directly for the home page hero.
assets/video/*
!assets/video/home-hero.mp4
